.env
.env.*
!.env.example
app/.dart_tool/
app/.flutter-plugins-dependencies
app/build/
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
app/ios/Flutter/ephemeral/
app/ios/Pods/
app/ios/.symlinks/
*.log

# --- Personal and local-only: never commit these ---
# your own Spotify app (copy app/assets/local/spotify.example.json to spotify.json)
app/assets/local/spotify.json
# signing keys and service files
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist
*.mobileprovision
*.p12
# per-developer iOS overrides
app/ios/Flutter/Local.xcconfig
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh

# --- Build outputs and tool junk ---
*.apk
*.aab
*.ipa
*.hprof
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/android/.cxx/
app/android/captures/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/ios/build/
app/ios/**/xcuserdata/
app/ios/.generated/
.DS_Store
.idea/
*.iml
.vscode/
.claude/

# reference images used while designing (local only)
assets/references/

# TLC model checker scratch files (the results/ logs are kept on purpose)
spec/*.old
spec/states/
spec/*_TTrace_*

# --- Windows app: build outputs and Visual Studio files (app/windows has its own list too) ---
app/windows/flutter/ephemeral/
app/windows/build/
app/windows/out/
app/windows/x64/
app/windows/.vs/
*.exe
*.msix
*.appx
*.pdb
*.ilk
*.obj
*.suo
*.user
*.sln.docstates
# Wheelhouse: the local briefing and session state (wheelhouse.json itself is committed)
.wheelhouse/

# Windows releases you package to share (zip the Release folder, or an installer)
dist/
*.msi
Hushdock-*.zip

# frame-time benchmark results (flutter drive ... card_switch_perf_test)
**/integration_response_data.json
*.timeline_summary.json
*.timeline.json

# --- Mac app: build outputs and Xcode/CocoaPods files ---
app/macos/Flutter/ephemeral/
app/macos/Pods/
app/macos/build/
app/macos/**/xcuserdata/
app/macos/Flutter/Flutter-Generated.xcconfig
app/macos/Flutter/GeneratedPluginRegistrant.swift
app/macos/Flutter/flutter_export_environment.sh

# the stub Flutter's `create` writes when a platform is added (the root README is the real one)
app/README.md
app/test/widget_test.dart
